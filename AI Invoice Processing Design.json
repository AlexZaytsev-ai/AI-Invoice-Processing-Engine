              "content": "You are an AI assistant that extracts structured information from supplier invoices.\n\nYou will receive the plain text extracted from a PDF invoice.\n\nYour task is to extract the required fields and return ONLY a valid JSON object that matches the provided JSON Schema.\n\nRules:\n\n- Do not invent information.\n- If a field is missing, return null.\n- Preserve the original values whenever possible.\n- Amounts must be returned as numbers.\n- Dates must use the YYYY-MM-DD format when possible.\n- Invoice numbers and tax identifiers must be returned as strings.\n- Return only JSON.\n- Do not include explanations or comments.\n\nThe document may contain OCR errors or inconsistent formatting.\nExtract the information as accurately as possible."
            },
            {
              "content": "={{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"document_type\": {\n      \"type\": \"string\",\n      \"enum\": [\"invoice\", \"not_invoice\"]\n    },\n    \"invoice_number\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"invoice_date\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Invoice date in YYYY-MM-DD format\"\n    },\n    \"supplier_name\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"supplier_inn\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"amount\": {\n      \"type\": [\"number\", \"null\"]\n    },\n    \"currency\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Three-letter currency code, for example RUB, USD, EUR\"\n    },\n    \"vat_amount\": {\n      \"type\": [\"number\", \"null\"]\n    },\n    \"bank_account\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"payment_due_date\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Payment due date in YYYY-MM-DD format\"\n    },\n    \"missing_fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"document_type\",\n    \"invoice_number\",\n    \"invoice_date\",\n    \"supplier_name\",\n    \"supplier_inn\",\n    \"amount\",\n    \"currency\",\n    \"vat_amount\",\n    \"bank_account\",\n    \"payment_due_date\",\n    \"missing_fields\"\n  ],\n  \"additionalProperties\": false\n}"
