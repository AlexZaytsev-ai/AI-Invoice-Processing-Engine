        "query": "INSERT INTO invoices (\n  invoice_number,\n  invoice_date,\n  supplier_name,\n  supplier_inn,\n  amount,\n  currency,\n  vat_amount,\n  bank_account,\n  status\n)\nVALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)\n\nON CONFLICT (supplier_inn, invoice_number)\nDO UPDATE SET\n  invoice_date = EXCLUDED.invoice_date,\n  supplier_name = EXCLUDED.supplier_name,\n  amount = EXCLUDED.amount,\n  currency = EXCLUDED.currency,\n  vat_amount = EXCLUDED.vat_amount,\n  bank_account = EXCLUDED.bank_account,\n  status = EXCLUDED.status,\n  version = invoices.version + 1,\n  updated_at = NOW()\n\nWHERE\n  invoices.amount IS DISTINCT FROM EXCLUDED.amount\n  OR invoices.currency IS DISTINCT FROM EXCLUDED.currency\n  OR invoices.vat_amount IS DISTINCT FROM EXCLUDED.vat_amount\n  OR invoices.invoice_date IS DISTINCT FROM EXCLUDED.invoice_date\n  OR invoices.bank_account IS DISTINCT FROM EXCLUDED.bank_account\n\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ $('Prepare Invoice Data Подготовить данные').item.json.invoice_number }}\n{{ $('Prepare Invoice Data Подготовить данные').item.json.invoice_date }}\n{{ $('Prepare Invoice Data Подготовить данные').item.json.supplier_name }}\n{{ $('Prepare Invoice Data Подготовить данные').item.json.supplier_inn }}\n{{ $('Prepare Invoice Data Подготовить данные').item.json.amount }}\n{{ $('Prepare Invoice Data Подготовить данные').item.json.currency }}\n{{ $('Prepare Invoice Data Подготовить данные').item.json.vat_amount }}\n{{ $('Prepare Invoice Data Подготовить данные').item.json.bank_account }}\n{{ $('Prepare Invoice Data Подготовить данные').item.json.status }}"
