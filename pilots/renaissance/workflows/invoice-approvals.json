      "id": "2260d438-a370-47cb-bf97-8d1972262cf9",
      "name": "Approval Trigger — Получить решение"
    },
    {
      "parameters": {
        "jsCode": "const q = $input.first().json.callback_query;\n\nconst match = /^ren:(approve|reject):([1-9]\\d*):([1-9]\\d*)$/\n  .exec(q?.data ?? '');\n\nconst authorized =\n  String(q?.from?.id) === 'YOUR_TELEGRAM_USER_ID' &&\n  String(q?.message?.chat?.id) === 'YOUR_TELEGRAM_CHAT_ID';\n\nreturn [{\n  json: {\n    valid: Boolean(match) && authorized,\n    callback_query_id: q?.id,\n    invoice_id: match ? Number(match[2]) : null,\n    version: match ? Number(match[3]) : null,\n    approval_status: match\n      ? (match[1] === 'approve' ? 'approved' : 'rejected')\n      : null,\n    decided_by: String(q?.from?.id ?? ''),\n    chat_id: q?.message?.chat?.id,\n    message_id: q?.message?.message_id\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -96
      ],
      "id": "4dbe4fe9-7eb8-4db8-a214-b6c9dc97d8bf",
      "name": "Parse Approval — Разобрать решение"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "7f6663ec-558b-434d-95da-39d3f31df01e",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        240,
        -96
      ],
      "id": "e3928402-8b9f-4634-ae19-e175f691674d",
      "name": "Approval Valid? — Решение допустимо?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH saved AS (\n  UPDATE renaissance.invoices\n  SET\n    approval_status = $3,\n    decided_by = $4,\n    decided_at = NOW(),\n    updated_at = NOW()\n  WHERE invoice_id = $1\n    AND version = $2\n    AND approval_status = 'pending'\n  RETURNING invoice_number, approval_status, amount, currency\n)\nSELECT\n  EXISTS (SELECT 1 FROM saved) AS applied,\n  (SELECT invoice_number FROM saved) AS invoice_number,\n  (SELECT approval_status FROM saved) AS approval_status,\n  (SELECT amount FROM saved) AS amount,\n  (SELECT currency FROM saved) AS currency;",
        "options": {
          "queryReplacement": "={{ [\n  $json.invoice_id,\n  $json.version,\n  $json.approval_status,\n  $json.decided_by\n] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        480,
        -256
      ],
      "id": "efa289f1-71fb-4a4e-af15-4a4e17351496",
      "name": "Save Approval — Сохранить решение"
    },
