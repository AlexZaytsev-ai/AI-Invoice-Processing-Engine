        "text": "={{ $('Approval Trigger — Получить решение').first().json.callback_query.message.text.replace(\n  'Статус: ожидает согласования',\n  $('Save Approval — Сохранить решение').first().json.approval_status === 'approved'\n    ? 'Статус: ✅ согласован'\n    : 'Статус: ❌ отклонён'\n) }}",
        "additionalFields": {}
