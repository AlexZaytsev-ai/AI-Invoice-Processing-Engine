      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  i.invoice_id,\n  i.invoice_number,\n  i.invoice_date,\n  e.event_name,\n  i.expense_category,\n  i.supplier_name,\n  i.amount,\n  i.currency,\n  i.version,\n  i.approval_status,\n  COALESCE(i.decided_by, '') AS decided_by,\n  COALESCE(i.decided_at::text, '') AS decided_at,\n  i.updated_at\nFROM renaissance.invoices i\nLEFT JOIN renaissance.events e ON e.event_id = i.event_id\nORDER BY i.invoice_id;",
